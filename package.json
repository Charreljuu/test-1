{
  "name": "personal-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "db:sql": "node scripts/json2sql.cjs",
    "db:init": "wrangler d1 execute cities-db --remote --config worker/wrangler.toml --file=worker/migrations/0001_init.sql",
    "db:deploy": "wrangler d1 execute cities-db --remote --config worker/wrangler.toml --file=d1/import.sql",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-map-interaction": "^2.1.0",
    "react-zoom-pan-pinch": "^4.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.10",
    "wrangler": "^4.120.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
